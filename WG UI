local JanitorConnections = {}

local function new(class, props, children)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do if k ~= "Parent" then o[k] = v end end
    for _, c in ipairs(children or {}) do c.Parent = o end
    if props and props.Parent then o.Parent = props.Parent end
    return o
end

local function corner(r) return new("UICorner", { CornerRadius = r or UDim.new(1, 0) }) end

local function tween(obj, t, props, style, dir)
    local tw = TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function loopGradient(g, t)
    g.Offset = Vector2.new(-1, 0)
    local tw = TweenService:Create(g, TweenInfo.new(t, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false), { Offset = Vector2.new(1, 0) })
    tw:Play()
end

function makeDraggable(frame)
    local dragging, startPos, startFramePos
    local conn1 = frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, startPos, startFramePos = true, input.Position, frame.Position
            local connEnd
            connEnd = input.Changed:Connect(function() 
                if input.UserInputState == Enum.UserInputState.End then 
                    dragging = false 
                    connEnd:Disconnect()
                end 
            end)
        end
    end)
    local conn2 = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - startPos
            frame.Position = UDim2.new(startFramePos.X.Scale, startFramePos.X.Offset + d.X, startFramePos.Y.Scale, startFramePos.Y.Offset + d.Y)
        end
    end)
    table.insert(JanitorConnections, conn1)
    table.insert(JanitorConnections, conn2)
end

