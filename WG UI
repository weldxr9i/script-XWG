local function FormatTime(s)
    return string.format("%02d:%02d:%02d", math.floor(s/3600), math.floor((s%3600)/60), s%60)
end

local function StripCharacter(char)
    if not char or not Config.PurgeAvatars or Players:GetPlayerFromCharacter(char) == Players.LocalPlayer then return end
    local function cleanObj(obj)
        if obj:IsA("Accessory") or obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") or obj:IsA("CharacterMesh") or obj:IsA("BodyColors") then pcall(function() obj:Destroy() end)
        elseif obj:IsA("BasePart") then obj.Material, obj.CastShadow, obj.Reflectance = Enum.Material.SmoothPlastic, false, 0 
        elseif obj:IsA("Animator") or obj:IsA("AnimationTrack") then pcall(function() obj:Stop() end) end
    end
    for _, obj in ipairs(char:GetDescendants()) do cleanObj(obj) end
    local childConn
    childConn = char.DescendantAdded:Connect(function(desc) if not Config.PurgeAvatars or not char:IsDescendantOf(Workspace) then childConn:Disconnect() return end cleanObj(desc) end)
    if char:FindFirstChildOfClass("Humanoid") then char:FindFirstChildOfClass("Humanoid").DisplayDistanceType = Enum.HumanoidDisplayDistanceType.All end
end

local function ExtremeSkyClean()
    local targets = {game:GetService("Lighting"), Workspace}
    if Workspace.CurrentCamera then table.insert(targets, Workspace.CurrentCamera) end
    for i = 1, #targets do
        local container = targets[i] local children = container:GetChildren()
        for j = 1, #children do
            local obj = children[j]
            if obj:IsA("Atmosphere") or obj:IsA("Sky") or obj:IsA("Clouds") or obj:IsA("BlurEffect") or obj:IsA("SunRaysEffect") or obj:IsA("BloomEffect") then pcall(function() obj:Destroy() end) end
        end
    end
end

local function OptimizeWorldObject(obj)
    if not obj then return end
    if Config.AntiExplosions then
        if obj:IsA("Explosion") then
            obj.BlastPressure, obj.BlastRadius = 0, 0 local kids = obj:GetChildren()
            for i = 1, #kids do local p = kids[i] if p:IsA("ParticleEmitter") or p:IsA("Fire") or p:IsA("Smoke") then p:Destroy() end end
        elseif obj:IsA("Decal") or obj:IsA("Texture") then pcall(function() obj:Destroy() end)
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Sparkles") then obj.Enabled = false end
    end
    if Config.UltimateBoost and obj:IsA("BasePart") and not Players:GetPlayerFromCharacter(obj.Parent) then obj.Material, obj.CastShadow, obj.Reflectance = Enum.Material.SmoothPlastic, false, 0 end
    if Config.ClearEffects then
        if obj:IsA("ParticleEmitter") or obj:IsA("Sparkles") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") then obj.Enabled = false
        elseif obj:IsA("Light") then obj.Enabled, obj.Shadows = false, false end
    end
end

local function PurgeMapToBaseplate()
    if not Config.BaseplateOnly then return end
    local items = Workspace:GetChildren() local chunk = 150
    for i = 1, #items do
        local item = items[i] if item ~= Workspace.CurrentCamera and not Players:GetPlayerFromCharacter(item) and item.Name ~= "Baseplate" then pcall(function() item:Destroy() end) end
        if i % chunk == 0 then task.wait() end
    end
end

