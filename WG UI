local function SetupTrackerLogic(p, isNew)
if not p then return end
local d = ServerDatabase[p.Name]
ServerDatabase[p.Name] = {UserId = p.UserId, TimeJoined = os.time(), PastSeconds = d and d.PastSeconds or 0, JoinsCount = d and (d.JoinsCount+1) or 1, LeavesCount = d and d.LeavesCount or 0, IsPresent = true, Status = isNew and "rj3" or "active", TrackingDisabled = d and d.TrackingDisabled or false}
if isNew then print("☣ [" .. CONFIG.CLAN_NAME .. " TRACKER]: " .. p.Name .. " دخل السيرفر!") end
if ScrollFrame then
CreatePlayerRow(p.Name, p.UserId)
local ui = UIEntries[p.Name]
if ui then ui.UpdateVisuals(true, ServerDatabase[p.Name].TrackingDisabled) end
end
if isNew then task.spawn(function() task.wait(3) local cur = ServerDatabase[p.Name] if cur and cur.IsPresent and not cur.TrackingDisabled then cur.Status = "active" end end) end
end
for _, p in pairs(Players:GetPlayers()) do SetupTrackerLogic(p, false) end
Players.PlayerAdded:Connect(function(p) SetupTrackerLogic(p, true) end)
Players.PlayerRemoving:Connect(function(p)
local d, ui = ServerDatabase[p.Name], UIEntries[p.Name]
if d and d.IsPresent then
d.IsPresent = false
print("☣ [" .. CONFIG.CLAN_NAME .. " TRACKER]: " .. p.Name .. " غادر السيرفر!")
d.LeavesCount, d.Status = d.LeavesCount + 1, "w333 hrb"
if not d.TrackingDisabled then
d.PastSeconds = d.PastSeconds + (os.time() - d.TimeJoined)
end
if ui then
ui.Indicator.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
ui.TextLabel.Text = string.format("hariba stute: %d | l9wad hrb: %d | status: %s | %s", d.JoinsCount, d.LeavesCount, d.Status, FormatTime(d.PastSeconds))
ui.UpdateVisuals(false, d.TrackingDisabled)
end
end
end)
